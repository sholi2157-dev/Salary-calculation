  "type": {
    "family": {
      "display": "Secular One",
      "body": "Rubik",
      "fallback": "Heebo, system-ui, sans-serif"
    },
    "rule": "Currency symbols (₪ $) always render in the body family; Secular One draws ₪ as letters.",
    "scale": {
      "hero": {
        "size": 64,
        "line": 1.0,
        "family": "display"
      },
      "amount": {
        "size": 26,
        "line": 1.1,
        "family": "display"
      },
      "title": {
        "size": 22,
        "line": 1.25,
        "family": "display"
      },
      "body": {
        "size": 16,
        "line": 1.45,
        "weight": 400
      },
      "label": {
        "size": 14,
        "line": 1.35,
        "weight": 600
      },
      "caption": {
        "size": 13,
        "line": 1.35,
        "weight": 400
      },
      "micro": {
        "size": 11,
        "line": 1.2,
        "weight": 600
      }
    },
    "numbers": "tabular-nums, isolated LTR inside RTL text"
  },
  "space": [
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    40
  ],
  "radius": {
    "sm": 10,
    "md": 14,
    "lg": 18,
    "xl": 24,
    "pill": 999
  },
  "touchTarget": 48,
  "motion": {
    "press": {
      "ms": 80,
      "scale": 0.97
    },
    "quick": {
      "ms": 160,
      "easing": "cubic-bezier(.2,.8,.2,1)"
    },
    "sheet": {
      "ms": 320,
      "easing": "cubic-bezier(.2,.8,.2,1)"
    },
    "celebrate": {
      "ms": 500,
      "easing": "cubic-bezier(.2,1.4,.4,1)"
    },
    "reducedMotion": "replace movement with opacity; no scale or bounce"
  },
  "haptics": {
    "tap": {
      "web": 6,
      "android": "HapticFeedbackConstants.VIRTUAL_KEY"
    },
    "tick": {
      "web": 4,
      "android": "HapticFeedbackConstants.CLOCK_TICK",
      "use": "ruler 15-minute steps"
    },
    "select": {
      "web": 14,
      "android": "HapticFeedbackConstants.LONG_PRESS",
      "use": "long-press multi-select"
    },
    "success": {
      "web": [
        12,
        60,
        22
      ],
      "android": "HapticFeedbackConstants.CONFIRM",
      "use": "save, confirm planned shift"
    },
    "warn": {
      "web": [
        35,
        50,
        35
      ],
      "android": "HapticFeedbackConstants.REJECT",
      "use": "delete, cancel active shift"
    },
    "setting": "Settings → רטט במגע (on by default)"
  },
  "theme": {
    "options": [
      "system",
      "light",
      "dark"
    ],
    "default": "system",
    "setting": "הגדרות → מראה → ערכת צבעים"
  },
  "notifications": {
    "quietHours": {
      "default": {
        "on": true,
        "from": "22:00",
        "to": "07:00"
      },
      "rule": "A notification due inside the window is delayed to its end, never dropped. Windows may cross midnight."
    }
  }
}