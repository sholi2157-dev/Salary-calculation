rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Anonymous install count: one create-only record per device, never read, changed or deleted by the app.
    // Only the owner's verified Google account may read the records, for the private dashboard (/admin).
    match /installs/{installId} {
      allow read: if request.auth != null && request.auth.token.email == 'sholi2157@gmail.com'
        && request.auth.token.email_verified == true;
      allow create: if installId.matches('^[a-f0-9]{32}$')
        && request.resource.data.keys().hasOnly(['version', 'kind', 'at'])
        && request.resource.data.version is string && request.resource.data.version.size() <= 32
        && request.resource.data.kind in ['new', 'update']
        && request.resource.data.at == request.time;
    }
    // Anonymous download count, written by the website's server: one create-only record per browser and version.
    match /downloads/{downloadId} {
      allow read: if request.auth != null && request.auth.token.email == 'sholi2157@gmail.com'
        && request.auth.token.email_verified == true;
      allow create: if downloadId.matches('^[a-f0-9]{32}$')
        && request.resource.data.keys().hasOnly(['version', 'at'])
        && request.resource.data.version is string && request.resource.data.version.size() <= 32
        && request.resource.data.at == request.time;
    }
  }
}
